# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/solnut-neet?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb+srv://username:password@cluster.mongodb.net/solnut-neet-test?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRE=7d

# AI & OCR
# Option 1: Google Gemini or Gemma (Recommended for fast/free cloud setup on Render)
# Get a free API key at: https://aistudio.google.com/
# Set AI_PROVIDER=gemini (or gemma)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# Model choice: gemini-2.0-flash (fastest & smart) or gemma-2-9b-it / gemma-2-27b-it
GEMINI_MODEL=gemini-2.0-flash
# Or specify GEMMA_MODEL:
# GEMMA_MODEL=gemma-2-9b-it

# Option 2: Groq (Ultra-fast Gemma 2 & Llama 3 — Free tier at https://console.groq.com)
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_your-groq-api-key
# GROQ_MODEL=gemma2-9b-it

# Option 3: AWS Bedrock (Native AWS SDK Converse API)
# In Render Dashboard -> Environment:
# Add AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY from your AWS IAM user with Bedrock permissions.
# Models: amazon.nova-lite-v1:0 | anthropic.claude-3-haiku-20240307-v1:0 | mistral.mistral-7b-instruct-v0:2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# (Optional) AWS Bedrock Bearer Token if using Bedrock Mantle / Gateway:
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# Option 4: OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
NURSING_AI_BATCH_SIZE=10
NURSING_AI_MAX_OUTPUT_TOKENS=3500
NURSING_AI_VALIDATION_MAX_TOKENS=1800
NURSING_DUPLICATE_THRESHOLD=78
NURSING_AUTO_APPROVE_THRESHOLD=85
NURSING_SCHEDULER_ENABLED=false
PDF_UPLOAD_LIMIT_MB=100
IMAGE_UPLOAD_LIMIT_MB=8
# PDF upload parses questions locally. Use POST /api/questions/classify for batched AI metadata.
PDF_IMPORT_AI_FALLBACK=false
SCANNED_PDF_AI_IMPORT=false
SCANNED_PDF_LOCAL_OCR=false
PDF_RENDERER_PATH=pdftoppm
OCR_MAX_PAGES=20
OCR_DPI=200

# Cloudinary (Image Storage)
CLOUDINARY_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Socket.io
SOCKET_PORT=5001

# Email (for notifications)
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SERVICE=gmail

# Admin Panel
# These are the unique owner credentials for /admin/login. Never commit real values.
ADMIN_EMAIL=owner@medicalmania.site
ADMIN_PASSWORD=use_a_long_unique_password_here
COMPANY_NAME=Medical Mania
COMPANY_WEBSITE_URL=https://medicalmania.site
COMPANY_SUPPORT_EMAIL=support@medicalmania.site

# Logging
LOG_LEVEL=debug
